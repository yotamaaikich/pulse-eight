{
  "name": "pulse-eight",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:auth": "node --test tests/auth*.test.mjs tests/desktop.test.mjs",
    "desktop:prepare": "node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:prepare && electron .",
    "desktop:build": "npm run desktop:prepare && electron-builder --win nsis zip --x64 --publish never",
    "security:check": "node scripts/check-security.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.118.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "main": "desktop/main.cjs",
  "description": "8キーで演奏するピアノ・リズムゲーム",
  "author": "yotamaaikich",
  "build": {
    "appId": "io.github.yotamaaikich.pianopulse",
    "productName": "PIANO PULSE",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "*.js",
      "*.mjs",
      "*.css",
      "index.html",
      "privacy.html",
      "icon.svg",
      "vendor/**",
      "audio/piano/**",
      "desktop/**",
      "!desktop/*.test.*",
      "!scripts/**",
      "!tests/**",
      "!cloud/**",
      "!node_modules/**"
    ],
    "protocols": [
      {
        "name": "PIANO PULSE login",
        "schemes": [
          "pianopulse"
        ]
      }
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PIANO-PULSE-${version}-${arch}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PIANO PULSE",
      "deleteAppDataOnUninstall": false,
      "artifactName": "PIANO-PULSE-Setup-${version}.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "overrides": {
    "@electron/asar": "4.3.1",
    "@electron/universal": "3.0.6",
    "minimatch": "11.0.3",
    "glob@>=9.0.0": "14.0.3"
  }
}
